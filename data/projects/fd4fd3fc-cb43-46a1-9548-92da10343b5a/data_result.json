      "code": "import pandas as pd\n\n# Read the input table using the pre-defined path variable\ndf_formation = pd.read_csv(INPUT_TABLE_PATH_d1)\n\n# Rename columns for clarity\ndf_formation.columns = ['index', 'frame_id', 'formation_type']\n\n# Drop any rows with missing values in critical columns\ndf_formation.dropna(subset=['frame_id', 'formation_type'], inplace=True)\n\n# Ensure frame_id is treated as integer\ndf_formation['frame_id'] = df_formation['frame_id'].astype(int)\n\n# Sort by frame_id to ensure chronological order\ndf_formation.sort_values(by='frame_id', inplace=True)\n\n# Identify key match events (this is a placeholder; in a real scenario, this data would come from another source)\n# For demonstration, we'll assume key events are provided in a separate DataFrame\n# Example: key_events = pd.DataFrame({'event_frame': [10, 25, 40], 'event_type': ['goal', 'substitution', 'corner']})\n\n# For this example, we will simulate key events for demonstration purposes\nkey_events = pd.DataFrame({\n    'event_frame': [10, 25, 40],\n    'event_type': ['goal', 'substitution', 'corner']\n})\n\n# Merge formation data with key events to find formation before and after each event\n# Use left join to include all events and their corresponding formations\nresult_df = pd.merge_asof(\n    key_events.sort_values('event_frame'),\n    df_formation.sort_values('frame_id'),\n    left_on='event_frame',\n    right_on='frame_id',\n    direction='backward'\n)\n\n# Rename columns for clarity\nresult_df.rename(columns={'formation_type': 'formation_before'}, inplace=True)\n\n# Find formation after the event by shifting the formation data\ndf_formation_shifted = df_formation.shift(-1).rename(columns={'formation_type': 'formation_after'})\n\n# Merge the shifted formation data with the key events\nresult_df = pd.merge(\n    result_df,\n    df_formation_shifted[['frame_id', 'formation_after']],\n    left_on='event_frame',\n    right_on='frame_id',\n    how='left'\n)\n\n# Drop unnecessary columns\nresult_df.drop(columns=['frame_id'], inplace=True)\n\n# Handle any remaining missing values\nresult_df.fillna({'formation_after': 'N/A'}, inplace=True)",
