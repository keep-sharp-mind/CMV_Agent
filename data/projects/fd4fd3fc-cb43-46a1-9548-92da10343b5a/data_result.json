      "code": "import pandas as pd\n\n# Read the input data\ndf = pd.read_csv(INPUT_TABLE_PATH_d1)\n\n# Clean column names for better readability\ndf.columns = ['index', 'frame_id', 'formation_type']\n\n# Handle missing values by dropping rows with missing formation types\ndf = df.dropna(subset=['formation_type'])\n\n# Segment the match into phases (example: first half, second half)\n# Assuming frame_id ranges from 0 to 9000, split into two halves\ndf['phase'] = pd.cut(df['frame_id'], bins=[-1, 4500, 9000], labels=['First Half', 'Second Half'])\n\n# Calculate frequency of each formation type per phase\nphase_formation_counts = df.groupby(['phase', 'formation_type']).size().unstack(fill_value=0)\n\n# Normalize the counts to get proportions for comparison across phases\nphase_formation_proportions = phase_formation_counts.div(phase_formation_counts.sum(axis=1), axis=0)\n\n# Reset index to make 'phase' a column\nresult_df = phase_formation_proportions.reset_index()\n\n# Rename columns for clarity\nresult_df.columns = ['Phase', 'Formation_4-2-4', 'Formation_2-3-5', 'Formation_other']\n\n# Fill any remaining missing values with 0\nresult_df = result_df.fillna(0)",
