      "code": "import pandas as pd\n\n# Read the input tables\ndf_d1 = pd.read_csv(INPUT_TABLE_PATH_D1)\ndf_d2 = pd.read_csv(INPUT_TABLE_PATH_D2)\n\n# Add a 'team' column to distinguish between the two datasets\ndf_d1['team'] = 'Argentina'\ndf_d2['team'] = 'Brazil'\n\n# Combine the dataframes\ncombined_df = pd.concat([df_d1, df_d2], ignore_index=True)\n\n# Group by formation_type and team, then calculate total frequency\ngrouped_df = combined_df.groupby(['team', 'formation_type'])['frequency'].sum().reset_index()\n\n# Calculate total frequency per team\ntotal_freq_per_team = grouped_df.groupby('team')['frequency'].transform('sum')\n\n# Calculate usage rate (frequency / total frequency per team)\ngrouped_df['usage_rate'] = grouped_df['frequency'] / total_freq_per_team\n\n# Rename columns for clarity\ngrouped_df.rename(columns={'team': 'team_name', 'formation_type': 'formation'}, inplace=True)\n\n# Store the final result in 'result_df'\nresult_df = grouped_df",
