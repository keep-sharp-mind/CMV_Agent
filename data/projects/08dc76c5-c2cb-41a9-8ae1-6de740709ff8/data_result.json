      "code": "import pandas as pd\n\n# Read the input tables using the pre-defined path variables\ndf_argentina = pd.read_csv(INPUT_TABLE_PATH_d1)\ndf_brazil = pd.read_csv(INPUT_TABLE_PATH_d2)\n\n# Define time intervals (example: first half, second half, overtime)\n# For this example, we'll assume frame_id can be used to determine time intervals\n# For instance, frame_id < 4500 could represent first half, 4500-9000 second half, and >9000 overtime\n# Adjust these thresholds based on actual data if needed\n\n# Segment data by time intervals for Argentina\nargentina_intervals = pd.cut(df_argentina['frame_id'], bins=[0, 4500, 9000, float('inf')], labels=['First Half', 'Second Half', 'Overtime'])\n\n# Segment data by time intervals for Brazil\nbrazil_intervals = pd.cut(df_brazil['frame_id'], bins=[0, 4500, 9000, float('inf')], labels=['First Half', 'Second Half', 'Overtime'])\n\n# Add time interval column to both DataFrames\ndf_argentina['time_interval'] = argentina_intervals\ndf_brazil['time_interval'] = brazil_intervals\n\n# Drop rows with missing values in 'formation_type' or 'time_interval'\ndf_argentina = df_argentina.dropna(subset=['formation_type', 'time_interval'])\ndf_brazil = df_brazil.dropna(subset=['formation_type', 'time_interval'])\n\n# Calculate frequency of each formation type within each time interval for both teams\nargentina_freq = df_argentina.groupby(['time_interval', 'formation_type']).size().unstack(fill_value=0)\nbrazil_freq = df_brazil.groupby(['time_interval', 'formation_type']).size().unstack(fill_value=0)\n\n# Combine results into a single DataFrame with team information\nargentina_freq = argentina_freq.reset_index()\nargentina_freq['team'] = 'Argentina'\n\nbrazil_freq = brazil_freq.reset_index()\nbrazil_freq['team'] = 'Brazil'\n\n# Concatenate both teams' results\nresult_df = pd.concat([argentina_freq, brazil_freq], ignore_index=True)\n\n# Rename columns for clarity\nresult_df.columns = ['time_interval', '4-4-2', '4-2-4', '2-3-5', 'team']\n\n# Ensure all formation types are present in the final DataFrame\nfor col in ['4-4-2', '4-2-4', '2-3-5']:\n    if col not in result_df.columns:\n        result_df[col] = 0\n\n# Reorder columns for consistency\nresult_df = result_df[['time_interval', 'team', '4-4-2', '4-2-4', '2-3-5']]",
