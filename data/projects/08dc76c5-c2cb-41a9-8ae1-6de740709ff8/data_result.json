      "code": "import pandas as pd\n\n# Read the input tables\ndf_d1 = pd.read_csv(INPUT_TABLE_PATH_D1)\ndf_d2 = pd.read_csv(INPUT_TABLE_PATH_D2)\n\n# Ensure the formation_type column is treated as a string to avoid issues\ndf_d1['formation_type'] = df_d1['formation_type'].astype(str)\ndf_d2['formation_type'] = df_d2['formation_type'].astype(str)\n\n# Identify common and unique formations\ncommon_formations = pd.merge(df_d1, df_d2, on='formation_type', how='inner')\nunique_to_d1 = pd.merge(df_d1, df_d2, on='formation_type', how='left', indicator=True).query('_merge == 'left_only')\nunique_to_d2 = pd.merge(df_d1, df_d2, on='formation_type', how='right', indicator=True).query('_merge == 'right_only')\n\n# Rename columns for clarity\ncommon_formations = common_formations.rename(columns={'frequency_x': 'argentina_frequency', 'frequency_y': 'brazil_frequency'})\nunique_to_d1 = unique_to_d1.rename(columns={'frequency': 'argentina_frequency'})\nunique_to_d2 = unique_to_d2.rename(columns={'frequency': 'brazil_frequency'})\n\n# Reset index for clean output\ncommon_formations = common_formations.reset_index(drop=True)\nunique_to_d1 = unique_to_d1.reset_index(drop=True)\nunique_to_d2 = unique_to_d2.reset_index(drop=True)\n\n# Combine results into a single DataFrame\nresult_df = pd.concat([\n    common_formations,\n    unique_to_d1[['formation_type', 'argentina_frequency']],\n    unique_to_d2[['formation_type', 'brazil_frequency']]\n], ignore_index=True)\n\n# Handle missing values by filling NaN with 0\nresult_df['argentina_frequency'] = result_df['argentina_frequency'].fillna(0).astype(int)\nresult_df['brazil_frequency'] = result_df['brazil_frequency'].fillna(0).astype(int)",
