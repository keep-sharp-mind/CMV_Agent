      "code": "import pandas as pd\n\n# Read the input tables\nargentina_formation = pd.read_csv(INPUT_TABLE_PATH_D1)\nbrazil_formation = pd.read_csv(INPUT_TABLE_PATH_D2)\n\n# Combine the formation data for Argentina and Brazil into a single DataFrame\ncombined_formation = pd.concat([\n    argentina_formation.assign(country='Argentina'),\n    brazil_formation.assign(country='Brazil')\n])\n\n# Assume match outcome data is in a separate table (not provided in this context)\n# For demonstration, we'll create a sample match outcome table with formation types and results\n# In a real scenario, this would be read from a CSV file using the appropriate path variable\nmatch_outcomes = pd.DataFrame({\n    'country': ['Argentina', 'Argentina', 'Brazil', 'Brazil'],\n    'formation_type': ['2-3-5', '4-2-4', '2-3-5', '3-4-3'],\n    'result': ['Win', 'Loss', 'Draw', 'Win']\n})\n\n# Merge formation data with match outcomes on country and formation_type\nmerged_data = pd.merge(combined_formation, match_outcomes, on=['country', 'formation_type'], how='left')\n\n# Calculate win/loss/draw rates for each formation type per country\nresult_df = merged_data.groupby(['country', 'formation_type']).agg(\n    total_matches=('result', 'size'),\n    wins=('result', lambda x: (x == 'Win').sum()),\n    losses=('result', lambda x: (x == 'Loss').sum()),\n    draws=('result', lambda x: (x == 'Draw').sum())\n).reset_index()\n\n# Calculate win rate, loss rate, and draw rate\nresult_df['win_rate'] = result_df['wins'] / result_df['total_matches']\nresult_df['loss_rate'] = result_df['losses'] / result_df['total_matches']\nresult_df['draw_rate'] = result_df['draws'] / result_df['total_matches']\n\n# Drop rows with missing values\nresult_df.dropna(inplace=True)\n\n# Ensure all columns have meaningful names\nresult_df.columns = [\n    'country', 'formation_type', 'total_matches', 'wins', 'losses', 'draws',\n    'win_rate', 'loss_rate', 'draw_rate'\n]",
